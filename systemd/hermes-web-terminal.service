[Unit]
Description=Hermes Web Terminal - Web-based terminal interface with PTY support
After=network.target

[Service]
Type=simple
Restart=always
RestartSec=5
User=nimit
WorkingDirectory=/home/nimit

# Environment file containing configuration
EnvironmentFile=/etc/hermes-web-terminal/env

# Run via uv for proper dependency management
ExecStart=/home/nimit/.local/bin/uv run --package hermes-web-terminal hermes-web-terminal

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-web-terminal

[Install]
WantedBy=multi-user.target