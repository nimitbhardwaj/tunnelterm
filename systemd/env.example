# Environment file for tunnelterm systemd service.
# Copy to /etc/tunnelterm/env and customize.

# Password for authentication (REQUIRED).
TUNNELTERM_PASSWORD=your_secure_password_here

# Optional: override default host (default: 127.0.0.1).
# TUNNELTERM_HOST=127.0.0.1

# Optional: override default port (default: 4200).
# TUNNELTERM_PORT=4200

# Optional: comma-separated list of allowed Origin headers for the WebSocket
# handshake. If unset, only same-origin requests are accepted.
# TUNNELTERM_ALLOWED_ORIGINS=https://terminal.example.com
