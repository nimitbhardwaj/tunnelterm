# Environment file for hermes-web-terminal systemd service
# Copy to /etc/hermes-web-terminal/env and customize values

# Password for authentication (REQUIRED for production)
HERMES_WEB_TERMINAL_PASSWORD=your_secure_password_here

# Optional: Override default host (default: 127.0.0.1)
# HOST=0.0.0.0

# Optional: Override default port (default: 4200)
# PORT=4200